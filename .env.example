# Copia a .env. NO commitear valores reales.
API_URL=http://localhost:8000
SCORE_MODEL_VERSION=1.0.0

# LLM (OpenRouter). Sin key → análisis rule-based.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free

# Perfil Keedio (scoring) — coma-separados.
CPV_PREFERRED=72,48
CPV_EXCLUDED=45,90,79710000
BUDGET_MIN=50000
BUDGET_TARGET_LOW=150000
BUDGET_TARGET_HIGH=800000
DEADLINE_MIN_DAYS=7
DEADLINE_COMFORTABLE_DAYS=21
